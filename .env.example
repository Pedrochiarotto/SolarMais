# Deixe AMBOS vazios para usar o conteúdo demonstrativo local.
# A landing usa os conteúdos locais por padrão. Defina como true para ativar o Sanity.
USE_SANITY=false
SANITY_PROJECT_ID=
SANITY_DATASET=
# Opcional: somente para dataset privado. Nunca use prefixo PUBLIC_ para tokens.
SANITY_API_READ_TOKEN=
# Endpoint público de captação; não é uma credencial. Relativo ou HTTPS.
PUBLIC_LEAD_ENDPOINT=
# Somente para o comando studio:seed; não configure este token na hospedagem.
SANITY_API_WRITE_TOKEN=
