---
const { content } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<header class="site-header sticky top-0 z-50 border-b border-white/20 bg-black">
    <div class="page-shell flex min-h-20 flex-wrap items-center justify-between gap-3 py-3">
      <a class="inline-flex min-h-12 items-center" href={`${base}#topo`} aria-label="SolarMais — início">
        <span class="brand-lockup" aria-hidden="true"><img src={content.logo} width="150" height="150" alt="" /></span>
      </a>
      <nav class="nav-panel order-3 flex w-full flex-col border-t border-white/20 pt-3 lg:order-none lg:w-auto lg:flex-row lg:items-center lg:gap-6 lg:border-0 lg:pt-0" id="primaryNav" aria-label="Navegação principal">
        <a class="nav-link" href={`${base}#solucoes`}>Soluções</a>
        <a class="nav-link" href={`${base}projetos/`} aria-current={Astro.url.pathname.includes("/projetos") ? "page" : undefined}>Projetos</a>
        <a class="nav-link" href={`${base}#beneficios`}>Benefícios</a>
        <a class="nav-link" href={`${base}#como-funciona`}>Como funciona</a>
        <a class="nav-link" href={`${base}#duvidas`}>Dúvidas</a>
        <a class="nav-link text-brand lg:hidden" href={`${base}#cadastro`}>Solicitar avaliação</a>
      </nav>
      <div class="flex items-center gap-2">
        <button class="icon-button" id="themeToggle" type="button" aria-label="Ativar tema escuro" hidden>
          <svg class="theme-icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" /></svg>
          <svg class="theme-icon-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <a class="button button-primary hidden lg:inline-flex" href={`${base}#cadastro`}>Solicitar avaliação</a>
        <button class="icon-button lg:hidden" id="menuToggle" type="button" aria-controls="primaryNav" aria-expanded="false" aria-label="Abrir menu" hidden><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
      </div>
    </div>
  </header>
