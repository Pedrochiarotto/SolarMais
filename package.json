{
  "name": "solarmais-landing-page",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --minify",
    "predev": "npm run css && npm run assets",
    "dev": "astro dev",
    "prebuild": "npm run css && npm run assets",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "studio:dev": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "studio:seed": "node --env-file=.env scripts/seed-sanity.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "astro": "^7.3.8"
  }
}
